# Supabase (https://supabase.com/dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Secreto usado para cifrar las API keys de IA antes de guardarlas en la base de datos.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
API_KEY_ENCRYPTION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# (Opcional) URL base del API de Vibi para generar la voz de los guiones.
# Por defecto: https://api.vibi.pro
# La clave de Vibi se guarda cifrada en Ajustes, no aquí.
VIBI_API_BASE_URL=https://api.vibi.pro
