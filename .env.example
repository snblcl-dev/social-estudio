# Base de datos SQLite (ruta relativa al directorio prisma/).
DATABASE_URL="file:../data/app.db"

# Better Auth (https://www.better-auth.com/docs/installation#set-environment-variables)
# Genera el secreto con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# URL pública de la app (para cookies y CSRF). Sin barra final.
BETTER_AUTH_URL=https://tu-dominio.com

# Secreto usado para cifrar las API keys de IA antes de guardarlas en la base de datos.
# Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
API_KEY_ENCRYPTION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# (Opcional) URL base del API de Vibi para generar la voz de los guiones.
# Por defecto: https://api.vibi.pro
# La clave de Vibi se guarda cifrada en Ajustes, no aquí.
VIBI_API_BASE_URL=https://api.vibi.pro

# (Opcional) Puerto del servidor Next.js. Por defecto 3000.
# PORT=3000
